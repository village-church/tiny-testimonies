---
import Page from "../../layouts/Page.astro";
import Title from "../../components/stories/Title.astro";
import Tile from "../../components/stories/Tile.astro";
import { getCollection } from "astro:content";
import LatestStory from "../../components/stories/LatestStory.astro";

const stories = (await getCollection("story")).sort(
  (a, b) => b.data.volume - a.data.volume,
);
---

<Page title="Our Stories">
  <heading>
    <Title title="Our Stories" subtitle="Tiny Testimonies of God's Love" />
  </heading>
  <main class="relative mt-12">
    <div class="prose-lg mb-24">
      <p class="font-quicksand font-medium text-storyprimary">
        When we share our stories with others, we have the opportunity to share
        how we encounter God in day-to-day life. We have the opportunity to
        break down barriers of divide and shame, as well as fear and comparison.
        We have the opportunity to pause and remember what God has done in our
        lives.
      </p>
      <p class="font-quicksand font-medium text-storyprimary">
        These Tiny Testimonies are our experiences with God that we get to share
        with one another. Some are big, some are small. Some are deeply
        impactful, some are light and humorous. But all of them matter.
      </p>
    </div>
    <section class="mb-24">
      <h2 class="text-5xl font-bold font-playfair-display text-storyprimary mb-8">
        Read the lastest
      </h2>
      <LatestStory />
    </section>
    <section class="mb-24">
      <h2 class="text-5xl font-bold font-playfair-display text-storyprimary mb-8">
        Check out the Podcast
      </h2>
      <iframe
        data-testid="embed-iframe"
        style="border-radius:12px"
        src="https://open.spotify.com/embed/show/0yvYgg04V86uaEgOmlIi78?utm_source=generator&si=6805c0ba97b44133"
        width="100%"
        height="352"
        allowfullscreen=""
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        loading="lazy"
      ></iframe>
    </section>
    <section>
      <h2 class="text-5xl font-bold font-playfair-display text-storyprimary mb-8">
        Story Archive
      </h2>
      {stories.length === 0 ? (
        <div class="bg-storysecondary p-8 text-6xl text-storyprimary font-bold font-noto-sans-mono text-center uppercase">
          Coming Soon!
        </div>
      ) : (
        <div class="flex flex-row justify-start flex-wrap gap-4">
          {stories.reverse().map((story) => (
            <Tile
              title={story.data.title}
              slug={story.data.slug}
              volume={story.data.volume}
              author={story.data.author}
              excerpt={story.data.excerpt}
            />
          ))}
        </div>
      )}
    </section>
  </main>
</Page>
