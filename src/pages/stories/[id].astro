---
import { getCollection } from "astro:content";
import Page from "../../layouts/Page.astro";
import Quote from "../../components/stories/Quote.astro";
import Marker from "../../components/stories/Marker.astro";
import Title from "../../components/stories/Title.astro";
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";

export async function getStaticPaths() {
  const stories = await getCollection("story");
  return stories.map((story) => ({
    params: { id: story.id },
    props: { story },
  }));
}

interface Props {
  story: CollectionEntry<"story">;
}

const { story } = Astro.props;

const { Content } = await render(story);
---

<Page title=`${story.data.title} | Our Stories`>
  <heading class="flex flex-col md:flex-row gap-8 sm:gap-4 justify-between mb-8 text-storyprimary">
    <Title title={story.data.title} author={story.data.author} />
    <Marker volume={story.data.volume} />
  </heading>
  <article class="font-quicksand font-medium text-lg indent-8 mb-16">
    {story.data.spotifyEmbedURL && <iframe
      class="mb-8"
      data-testid="embed-iframe"
      style="border-radius:12px"
      src={story.data.spotifyEmbedURL}
      width="100%"
      height="152"
      allowfullscreen=""
      allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
      loading="lazy"
    ></iframe>}
    {story.data.quote && <Quote text={story.data.quote} />}
    <div class="prose prose-xl max-w-none indent-0">
      <Content />
    </div>
  </article>
</Page>
