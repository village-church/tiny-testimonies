---
import { getCollection } from "astro:content";
import OurStoryCardDesktop from "./OurStoryCardDesktop.astro";

const latestStory = (await getCollection("story")).sort(
  (a, b) => b.data.volume - a.data.volume,
)[0];
---

<article class="transition-all border border-gray-300 duration-300 hover:shadow-story-lg hover:-translate-y-2 hover:-translate-x-1 active:shadow-story-md active:-translate-y-1 active:-translate-x-0.5">
  <a href=`/stories/${latestStory.data.slug}` class="min-h-40 flex">
    <div class="flex flex-col grow min-w-0">
      <h3 class="text-2xl sm:text-4xl font-bold font-playfair-display text-storyprimary mb-2 px-2 wrap-break-word">
        {latestStory.data.title}
      </h3>
      {latestStory.data.excerpt && (
        <p class="px-2 font-quicksand font-medium text-storyprimary line-clamp-3">
          {latestStory.data.excerpt}
        </p>
      )}
      <span class="uppercase font-bold font-noto-sans-mono text-sm text-storyprimary p-2 leading-none mt-auto">
        By {latestStory.data.author}
      </span>
    </div>
    <OurStoryCardDesktop volume={latestStory.data.volume} />
  </a>
</article>
