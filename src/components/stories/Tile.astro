---
interface Props {
  title: string;
  slug: string;
  volume?: number;
  author?: string;
}

const { title, volume, slug, author } = Astro.props;
---

<article class="md:w-75 transition-all duration-300 hover:shadow-story-lg hover:-translate-y-2 hover:-translate-x-1 active:shadow-story-md active:-translate-y-1 active:-translate-x-0.5">
  <a href=`/stories/${slug}`>
    <div class="bg-storysecondary p-1 text-storyprimary text-nowrap font-noto-sans-mono font-bold text-sm leading-tight mb-2">
      VOL. {volume}
    </div>
    <div>
      <h3 class="text-4xl font-bold font-playfair-display text-storyprimary mb-2">
        {title}
      </h3>

      <span class="uppercase font-bold font-noto-sans-mono font-sm text-storyprimary">
        By {author}
      </span>
    </div>
  </a>
</article>
